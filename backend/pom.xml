<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.2</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.leash</groupId>
	<artifactId>leash-parent</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>Leash</name>
	<description>Spend controls and an audit trail for AI agents that pay</description>
	<url>https://github.com/anupkumarsharma9705/leash</url>
	<licenses>
		<license>
			<name>MIT License</name>
			<url>https://opensource.org/licenses/MIT</url>
			<distribution>repo</distribution>
		</license>
	</licenses>
	<developers>
		<developer>
			<id>anupkumarsharma9705</id>
			<name>Anup Kumar Sharma</name>
			<url>https://github.com/anupkumarsharma9705</url>
		</developer>
	</developers>
	<scm>
		<connection>scm:git:https://github.com/anupkumarsharma9705/leash.git</connection>
		<developerConnection>scm:git:ssh://git@github.com/anupkumarsharma9705/leash.git</developerConnection>
		<tag>HEAD</tag>
		<url>https://github.com/anupkumarsharma9705/leash</url>
	</scm>
	<modules>
		<module>leash-core</module>
		<module>leash-backend</module>
	</modules>
	<properties>
		<java.version>21</java.version>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<jacoco.version>0.8.13</jacoco.version>
	</properties>
	<build>
		<plugins>
			<plugin>
				<groupId>com.diffplug.spotless</groupId>
				<artifactId>spotless-maven-plugin</artifactId>
				<version>3.11.0</version>
				<configuration>
					<java>
						<googleJavaFormat>
							<version>2.0.0</version>
							<style>GOOGLE</style>
						</googleJavaFormat>
					</java>
				</configuration>
				<executions>
					<execution>
						<id>spotless-check</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
