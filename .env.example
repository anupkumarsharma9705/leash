# Copy to .env and fill real values. NEVER commit .env.

# ===== PayPal sandbox =====
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Created when the deployed webhook is registered in the PayPal dashboard (Slice 1.6).
PAYPAL_WEBHOOK_ID=
# Sandbox personal account that receives the one-time $1.00 Gate G1 payout (Slice 1.4).
PAYPAL_SPIKE_RECIPIENT_EMAIL=
# Safety guard: must stay false. The app refuses to boot against a non-sandbox host unless true.
LEASH_ALLOW_LIVE=false

# ===== Database (local docker-compose defaults) =====
DB_HOST=localhost
DB_PORT=5432
DB_NAME=leash
DB_USER=leash
# No default: must be set in .env (docker-compose.yml still uses leash-local-only for local dev)
DB_PASSWORD=

# ===== Admin console =====
# No usable default: the app refuses to start without both values.
# Generate a unique password for any shared deployment. Never use the README's local test password.
LEASH_ADMIN_USERNAME=admin
# BCrypt hash only, never plaintext. Generate one with:
#   htpasswd -bnBC 10 "" 'your-password' | tr -d ':\n'
# or a short Java snippet using BCryptPasswordEncoder.
LEASH_ADMIN_PASSWORD_HASH=
# The legacy ADMIN_USERNAME / ADMIN_PASSWORD_HASH names are still accepted for existing .env files.
# Brute-force limiter: leave true in every real deployment. Tests disable it explicitly.
LEASH_ADMIN_RATE_LIMIT_ENABLED=true

# ===== Demo agent runtime LLM (optional) =====
# Set all three values to enable LLM tool calling in the demo. Leave blank for SCRIPTED mode.
# The endpoint must be OpenAI-compatible. Include the provider's version prefix if it needs one:
#   DeepSeek: https://api.deepseek.com        model: deepseek-chat
#   OpenAI:   https://api.openai.com/v1       model: gpt-4.1-mini
LEASH_LLM_BASE_URL=
LEASH_LLM_API_KEY=
LEASH_LLM_MODEL=
LEASH_LLM_TIMEOUT=30s
LEASH_LLM_MAX_ITERATIONS=8
LEASH_LLM_TEMPERATURE=0.0

# ===== App =====
PORT=8080
SPRING_PROFILES_ACTIVE=local
LEASH_MAX_PAYMENT_MINOR=100000

# ===== Database pool (Hikari) =====
# Tune for production load: reconciler + demo + admin concurrent requests.
HIKARI_MAX_POOL_SIZE=20
HIKARI_MIN_IDLE=5
HIKARI_CONNECTION_TIMEOUT=30000
HIKARI_IDLE_TIMEOUT=600000
HIKARI_MAX_LIFETIME=1800000
HIKARI_LEAK_THRESHOLD=60000

# ===== Reconciler =====
# Keep false while PayPal credentials are absent so parked APPROVED payments do not log retries.
LEASH_RECONCILER_ENABLED=false
LEASH_RECONCILER_INTERVAL=30s
# Per-payment retry backoff doubles from the interval and is capped here.
LEASH_RECONCILER_MAX_RETRY_BACKOFF=1h

# ===== Demo profile (SPRING_PROFILES_ACTIVE=local,demo) =====
LEASH_DEMO_AGENT_NAME=Invoice Agent
LEASH_DEMO_WEEKLY_LIMIT_MINOR=200000
LEASH_DEMO_AUTO_APPROVE_THRESHOLD_MINOR=5000
LEASH_DEMO_ALLOWED_PAYEE=alice@example.com
